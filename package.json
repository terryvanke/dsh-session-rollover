{
  "name": "dsh-session-rollover",
  "version": "0.1.0",
  "description": "Automatic fresh-session handoff for long-running DeepSeek Harness agents",
  "keywords": ["deepseek-harness", "dsh", "agent", "session-rollover", "checkpoint", "context-window"],
  "license": "MIT",
  "author": "terryvanke",
  "repository": {"type": "git", "url": "git+https://github.com/terryvanke/dsh-session-rollover.git"},
  "homepage": "https://github.com/terryvanke/dsh-session-rollover#readme",
  "bugs": {"url": "https://github.com/terryvanke/dsh-session-rollover/issues"},
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {".": {"types": "./dist/index.d.ts", "default": "./dist/index.js"}},
  "files": ["dist", "cordis.patch.yml", "README.md", "README.zh.md"],
  "dsh": {"bundle": {"patch": "./cordis.patch.yml"}},
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:unit": "vitest run tests/context-monitor.spec.ts tests/checkpoint.spec.ts tests/rollover.spec.ts tests/recovery.spec.ts",
    "test:e2e": "vitest run tests/e2e.spec.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.1",
    "@deepseek-ai/dsh-session": "0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.1.7-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.1",
    "@deepseek-ai/dsh-session": "0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.1.7-rc.1",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
