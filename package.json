{
  "name": "dsh-session-rollover",
  "version": "0.2.0",
  "description": "Session handoff for DeepSeek Harness and local task checkpoints for MCP Agent tools",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "agent",
    "session-rollover",
    "checkpoint",
    "context-window",
    "mcp",
    "trae",
    "workbuddy"
  ],
  "license": "MIT",
  "author": "terryvanke",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/terryvanke/dsh-session-rollover.git"
  },
  "homepage": "https://github.com/terryvanke/dsh-session-rollover#readme",
  "bugs": {
    "url": "https://github.com/terryvanke/dsh-session-rollover/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {"session-rollover-mcp": "./dist/mcp/cli.js"},
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "examples",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "pnpm run build && vitest run",
    "test:unit": "vitest run tests/context-monitor.spec.ts tests/checkpoint.spec.ts tests/rollover.spec.ts tests/recovery.spec.ts tests/mcp-checkpoints.spec.ts",
    "test:e2e": "vitest run tests/e2e.spec.ts",
    "test:mcp": "pnpm run build && vitest run tests/mcp.spec.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4 || ~4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-token-meter": "0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.4 || ~3.18.5-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {"optional": true},
    "@deepseek-ai/dsh-agent": {"optional": true},
    "@deepseek-ai/dsh-llm": {"optional": true},
    "@deepseek-ai/dsh-session": {"optional": true},
    "@deepseek-ai/dsh-token-meter": {"optional": true},
    "@deepseek-ai/schemastery": {"optional": true}
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-token-meter": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.5"
  }
}
